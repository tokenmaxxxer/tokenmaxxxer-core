{
  "conformance-review": [
    {
      "hook": "review/hooks/state.sh",
      "mode": "tracker",
      "event": "SessionStart",
      "kill_switch_env": "CONFORMANCE_REVIEW_STATE_OFF",
      "tracker_action": "context_informer"
    }
  ],
  "customer-support": [
    {
      "hook": "customer-support-phase1-order/hooks/phase1-order-gate.sh",
      "mode": "gate",
      "event": "PreToolUse",
      "kill_switch_env": "CUSTOMER_SUPPORT_PHASE1_ORDER_GATE_OFF",
      "target_path_regex": "^docs/issue-([0-9]+)/proposals/customer-support\\.md$",
      "step_sequence": [],
      "extra_checks": [
        {
          "type": "artifact_exists_before",
          "artifacts": [
            {"tag": "artifact-order:survey", "path_template": "docs/issue-{n}/reports/customer-support/survey.md"},
            {"tag": "artifact-order:scout-brief", "path_template": "docs/issue-{n}/reports/customer-support/scout-brief.md"}
          ]
        },
        {
          "type": "citation_adjacency",
          "citation_regex": "scout-brief\\.md|https?://",
          "window_lines": 3,
          "facets": [
            {"tag": "uncited-claim:sla", "keyword_regex": "sla"},
            {"tag": "uncited-claim:escalation", "keyword_regex": "escalation"},
            {"tag": "uncited-claim:playbook", "keyword_regex": "playbook"},
            {"tag": "uncited-claim:evidence-metric", "keyword_regex": "evidence metric"},
            {"tag": "uncited-claim:five-whys", "keyword_regex": "5-whys|five whys"}
          ],
          "message_template": "proposal write is missing required element(s): {missing}. Per docs/issue-1/proposals/customer-support.md §1, phase-1 proposals must follow the survey→scout-brief→proposal order and cite every structural claim to a scout-brief.md or http(s) source within the same paragraph as the claim."
        }
      ]
    }
  ],
  "defect-verification": [
    {
      "hook": "verify-state-guard/hooks/verify-state.sh",
      "mode": "tracker",
      "event": "PostToolUse",
      "kill_switch_env": "VERIFY_STATE_GUARD_OFF",
      "tracker_action": "loop_state_rank_bump",
      "record_path_regex": "^docs/issue-([0-9]+)/reports/verify\\.md$",
      "state_path_template": ".claude/verify-state-issue-{n}.json",
      "ranks": {"idle": 0, "reproducing": 1, "reproduced": 2, "cleared": 3}
    }
  ],
  "execution-observation": [
    {
      "hook": "execution-observation/plugins/eo-state/hooks/state.sh",
      "mode": "tracker",
      "event": "SessionStart+PostToolUse",
      "kill_switch_env": "EXECUTION_OBSERVATION_STATE_OFF",
      "tracker_action": "marker_file_reset_or_touch",
      "marker_path_template": ".claude/.eo-read-marker",
      "touch_regex": "docs/issue-[^\"]*/(reports|proposals)/|gh (api|pr)"
    }
  ],
  "issue-retrospective": [
    {
      "hook": "timeline-order-gate/hooks/timeline-order-gate.sh",
      "mode": "gate",
      "event": "PreToolUse",
      "kill_switch_env": "ISSUE_RETROSPECTIVE_TIMELINE_ORDER_GATE_OFF",
      "target_path_regex": "^docs/issue-[0-9]+/reports/issue-retrospective\\.md$",
      "step_sequence": [],
      "extra_checks": [
        {
          "type": "heading_before_forbidden",
          "required_heading_regex": "(?im)^\\s*#{1,6}\\s*timeline\\b",
          "missing_message": "issue-retrospective record has no 'Timeline' section. Per issue #12's record norm, the record body must contain a chronological Timeline section, built only from other roles' records/PR history, preceding any causal claim.",
          "forbidden_before_regex": "(?i)\\bcontributing factor|\\broot cause\\b",
          "forbidden_message_template": "issue-retrospective record states a causal claim ({match!r}) before its Timeline section. Per issue #12's record norm, Timeline must precede any causal claim, even when both sections are present."
        }
      ]
    }
  ],
  "observability": [
    {
      "hook": "observability-methodology-selector/hooks/methodology-selector-gate.sh",
      "mode": "gate",
      "event": "PreToolUse",
      "kill_switch_env": "OBSERVABILITY_METHODOLOGY_SELECTOR_GATE_OFF",
      "target_path_regex": "^docs/issue-[0-9]+/proposals/.*observability.*\\.md$",
      "step_sequence": [],
      "extra_checks": [
        {
          "type": "needle_any_missing",
          "groups": [
            {
              "tag": "signal-methodology-name (RED/USE/Golden Signals 중 하나를 명명해야 함)",
              "topic_words": ["methodology", "method", "signal", "red", "use", "golden"],
              "needles": ["red method", "use method", "golden signals", "golden signal", "rate/errors/duration", "red (rate", "red(rate", " red/", "/red ", "red 방법", "use 방법"]
            },
            {
              "tag": "surface-classification (request-driven/resource-bound/service-rollup 중 하나로 표면을 분류해야 함)",
              "topic_words": ["surface", "classification", "classify", "표면", "분류"],
              "needles": ["request-driven", "request driven", "resource-bound", "resource bound", "service-rollup", "service rollup", "요청 기반", "자원 기반", "서비스 롤업"]
            }
          ],
          "message_template": "proposal is missing required phase-1 methodology-selection component(s): {missing}. Every phase-1 proposal must classify each touched surface and name exactly one signal methodology for it."
        }
      ]
    },
    {
      "hook": "observability-methodology-selector/hooks/methodology-selector-status.sh",
      "mode": "tracker",
      "event": "PostToolUse",
      "kill_switch_env": "OBSERVABILITY_METHODOLOGY_SELECTOR_STATUS_OFF",
      "tracker_action": "needle_state_record",
      "record_path_regex": "^docs/issue-[0-9]+/proposals/.*observability.*\\.md$",
      "state_path_template": ".observability-phase1-methods/{n}.json"
    },
    {
      "hook": "observability-phase-trace/hooks/phase-trace-gate.sh",
      "mode": "gate",
      "event": "PreToolUse",
      "kill_switch_env": "OBSERVABILITY_PHASE_TRACE_GATE_OFF",
      "target_path_regex": "^docs/issue-([0-9]+)/reports/observability\\.md$",
      "step_sequence": [],
      "extra_checks": [
        {
          "type": "adjacency_required",
          "trigger_regex": "(?i)이탈|deviat|switch|변경",
          "required_nearby_regex": "(?i)because|때문|이유|reason",
          "window_chars": 200,
          "message": "observability record states a deviation marker with no nearby reason marker (must state 'because'/'때문'/'이유'/'reason' near the deviation)."
        }
      ]
    }
  ],
  "performance-engineering": [
    {
      "hook": "performance-engineering-order-check/hooks/order-check.sh",
      "mode": "gate",
      "event": "PreToolUse",
      "kill_switch_env": "PERFORMANCE_ENGINEERING_ORDER_CHECK_OFF",
      "target_path_regex": "^docs/issue-[0-9]+/(proposals/.*\\.md|reports/performance-engineering\\.md)$",
      "step_sequence": [
        {"label": "workload-characterization", "marker_regex": "(?im)^#{1,6}\\s*.*\\b(workload|load profile|traffic profile)\\b"},
        {"label": "evidence", "marker_regex": "(?im)^#{1,6}\\s*.*\\b(evidence|benchmark|measurement)\\b"}
      ],
      "extra_checks": []
    },
    {
      "hook": "performance-engineering-session-informer/hooks/state.sh",
      "mode": "tracker",
      "event": "SessionStart",
      "kill_switch_env": "PERFORMANCE_ENGINEERING_SESSION_INFORMER_OFF",
      "tracker_action": "context_informer"
    }
  ],
  "pr-communications": [
    {
      "hook": "race-sequence/hooks/race-sequence-gate.sh",
      "mode": "gate",
      "event": "PreToolUse",
      "kill_switch_env": "RACE_SEQUENCE_GATE_DISABLE",
      "target_path_regex": "^docs/issue-[0-9]+/reports/pr-communications\\.md$",
      "step_sequence": [],
      "extra_checks": [
        {
          "type": "conditional_race_sequence",
          "condition_regex": "(?m)^loop_state:\\s*landed\\s*$",
          "section_heading_regex": "(?m)^## Communications plan\\s*$",
          "missing_section_message": "missing '## Communications plan' section",
          "labels": ["Research", "Action", "Communication", "Evaluation"],
          "label_regex": "^\\*\\*(Research|Action|Communication|Evaluation)\\*\\*\\s*:?\\s*$",
          "missing_labels_message_template": "missing top-level **{missing}** label(s) inside '## Communications plan' section, or out of RACE order",
          "field_checks": [
            {"section": "Action", "field_regex": "^\\*\\*Objective\\*\\*\\s*:?\\s*(.*)$", "message": "missing or empty '**Objective**:' line inside Action — loop_state should be objective-undeclared instead of landed"},
            {"section": "Communication", "field_regex": "^\\*\\*Channel\\*\\*\\s*:?\\s*(.*)$", "message": "missing or invalid '**Channel**:' line inside Communication"},
            {"section": "Evaluation", "field_regex": "^\\*\\*Output\\*\\*\\s*:?\\s*(.*)$", "message": "missing or empty '**Output**:' line inside Evaluation"},
            {"section": "Evaluation", "field_regex": "^\\*\\*Outcome\\*\\*\\s*:?\\s*(.*)$", "message": "missing or empty '**Outcome**:' line inside Evaluation — loop_state should be channel-data-unreachable if the data isn't in yet"}
          ]
        }
      ]
    }
  ],
  "risk-management": [
    {
      "hook": "erm-verdict-methodology/hooks/erm-order-gate.sh",
      "mode": "gate",
      "event": "PreToolUse",
      "kill_switch_env": "ERM_VERDICT_METHODOLOGY_GATE_OFF",
      "target_path_regex": "^docs/issue-[0-9]+/(proposals/.*risk-management.*|reports/risk-management)\\.md$",
      "step_sequence": [
        {"label": "Governance/context", "marker_regex": "(?m)^#{1,6}\\s+Governance/context\\b"},
        {"label": "Assessment", "marker_regex": "(?m)^#{1,6}\\s+Assessment\\b"},
        {"label": "Risk treatment", "marker_regex": "(?m)^#{1,6}\\s+Risk treatment\\b"},
        {"label": "Monitoring", "marker_regex": "(?m)^#{1,6}\\s+Monitoring\\b"}
      ],
      "extra_checks": [
        {
          "type": "distinct_pair",
          "first_regex": "risk-score-inherent[:\\s]+([^\\n]+)",
          "second_regex": "risk-score-residual[:\\s]+([^\\n]+)",
          "first_missing_message": "missing risk-score-inherent label within the Assessment section",
          "second_missing_message": "missing risk-score-residual label within the Assessment section",
          "equal_message": "risk-score-inherent and risk-score-residual share the same value — must be distinct",
          "scope_section": "Assessment"
        }
      ]
    }
  ],
  "user-discovery": [
    {
      "hook": "user-discovery-hypothesis-order/hooks/hypothesis-order-gate.sh",
      "mode": "gate",
      "event": "PreToolUse",
      "kill_switch_env": "USER_DISCOVERY_HYPOTHESIS_ORDER_GATE_OFF",
      "target_path_regex": "^docs/issue-([0-9]+)/reports/user-discovery\\.md$",
      "step_sequence": [],
      "extra_checks": [
        {
          "type": "hypothesis_state_or_marker",
          "evidence_marker_regex": "(?i)\\b(behavioral|recounted|opinion)\\b.*evidence|evidence.*\\b(behavioral|recounted|opinion)\\b",
          "verdict_marker_regex": "(?i)pain-confirmed|not-confirmed|insufficient-evidence",
          "state_path_template": "docs/issue-{n}/reports/user-discovery/.state.json",
          "state_key": "evidence_logged",
          "message": "hypothesis-order violation: record contains a verdict marker (pain-confirmed/not-confirmed/insufficient-evidence) with no evidence logged yet (neither an evidence marker in this write nor a prior evidence_logged state)."
        }
      ]
    },
    {
      "hook": "user-discovery-hypothesis-order/hooks/hypothesis-order-state-sync.sh",
      "mode": "tracker",
      "event": "PostToolUse",
      "kill_switch_env": "USER_DISCOVERY_HYPOTHESIS_ORDER_GATE_OFF",
      "tracker_action": "hypothesis_state_sync",
      "record_path_regex": "^docs/issue-([0-9]+)/reports/user-discovery\\.md$",
      "state_path_template": "docs/issue-{n}/reports/user-discovery/.state.json",
      "hyp_marker_regex": "(?i)\\b(hypothesis|h1|h2)\\b",
      "evidence_marker_regex": "(?i)\\b(behavioral|recounted|opinion)\\b.*evidence|evidence.*\\b(behavioral|recounted|opinion)\\b",
      "verdict_marker_regex": "(?i)pain-confirmed|not-confirmed|insufficient-evidence"
    }
  ],
  "ux-engineering": [
    {
      "hook": "ux-phase1-structure-gate/hooks/phase1-structure-gate.sh",
      "mode": "gate",
      "event": "PreToolUse",
      "kill_switch_env": "UX_PHASE1_STRUCTURE_GATE_OFF",
      "target_path_regex": "^docs/issue-[0-9]+/proposals/.*ux-engineering.*\\.md$",
      "step_sequence": [
        {"label": "Request", "marker_regex": "(?im)^#{1,6}\\s+request\\s*$"},
        {"label": "Survey summary", "marker_regex": "(?im)^#{1,6}\\s+survey summary\\s*$"},
        {"label": "Scout summary", "marker_regex": "(?im)^#{1,6}\\s+scout summary\\s*$"},
        {"label": "Adopted norms", "marker_regex": "(?im)^#{1,6}\\s+adopted norms\\s*$"},
        {"label": "Rationale", "marker_regex": "(?im)^#{1,6}\\s+rationale\\s*$"},
        {"label": "Plugin reflection plan", "marker_regex": "(?im)^#{1,6}\\s+plugin reflection plan\\s*$"},
        {"label": "Constraints", "marker_regex": "(?im)^#{1,6}\\s+constraints\\s*$"}
      ],
      "extra_checks": [
        {
          "type": "sources_or_paths_required",
          "sources_block_regex": "(?m)^\\s*Sources\\s*[:`]",
          "url_regex": "https?://",
          "report_path_regex": "docs/issue-[0-9]+/reports/[A-Za-z0-9._/-]+\\.md",
          "message": "proposal cites design references but has neither a URL-bearing 'Sources' block nor an existing on-disk docs/issue-N/reports/*.md path."
        }
      ]
    }
  ]
}
